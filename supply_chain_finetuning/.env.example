# Copy to the repository-root .env and fill in. NEVER commit the real file.
#
# Teacher (dataset generation) — must NOT be the same model family as the
# fine-tuned student (the student is microsoft/Phi-3-mini-4k-instruct).
TEACHER_BASE_URL=https://api.commandcode.ai/provider/v1
TEACHER_API_KEY=<your-key-here>
TEACHER_MODEL=z-ai/glm-5.3-flash

# Judge (LLM-as-scoring for evaluation). A DIFFERENT model than the teacher is
# strongly preferred to avoid self-preference. Suggested free option (Groq):
#   JUDGE_BASE_URL=https://api.groq.com/openai/v1
#   JUDGE_MODEL=llama-3.3-70b-versatile
# The gateway below is the documented fallback (a different family than the
# teacher is still recommended; identical models trigger a visible warning).
JUDGE_BASE_URL=https://api.commandcode.ai/provider/v1
JUDGE_API_KEY=<your-key-here>
JUDGE_MODEL=deepseek/deepseek-v4-flash
