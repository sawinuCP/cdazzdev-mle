# Copy to .env and fill in. NEVER commit the real .env file.
# The client is provider-agnostic: any OpenAI-compatible endpoint works
# by changing these three variables (e.g. Groq, OpenRouter, Z.ai).

LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=YOUR_API_KEY_HERE
LLM_MODEL=z-ai/glm-5.3-flash
LLM_TIMEOUT_S=120
