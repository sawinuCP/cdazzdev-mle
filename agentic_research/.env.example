# Copy to the repository-root .env and fill in. NEVER commit the real file.
# The client is provider-agnostic: any OpenAI-compatible endpoint works by
# changing these variables (e.g. Groq: https://api.groq.com/openai/v1 with
# llama-3.3-70b-versatile, or OpenRouter).
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=<your-key-here>
LLM_MODEL=z-ai/glm-5.3-flash
LLM_TIMEOUT_S=300
